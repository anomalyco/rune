{
  "name": "rune-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun scripts/build.ts",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "icons": "bun scripts/icons.ts",
    "deploy:dev": "bun scripts/build.ts --mode dev && cf deploy --prebuilt --mode dev",
    "deploy:production": "bun scripts/build.ts --mode production && cf deploy --prebuilt --mode production"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@cloudflare/build-output-utils": "0.8.5",
    "@cloudflare/vite-plugin": "2.0.0-beta.v.4",
    "@types/bun": "1.3.13",
    "@types/node": "25.5.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "cf": "1.0.0-beta.12",
    "typescript": "6.0.2",
    "vite": "8.1.3"
  }
}
