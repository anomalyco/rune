+
+    #[test]
+    fn a_vk_packet_key_down_is_not_remembered() {
+        let b = KeyEventBuilder::default();
+        let typed = feed(&b, &[(WM_KEYDOWN, VK_PACKET as usize, 1), (WM_CHAR, 0xe9, 1), (WM_KEYUP, VK_PACKET as usize, up(0))]);
+        assert_eq!(typed, "é");
