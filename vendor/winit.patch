+    #[test]
+    fn focus_loss_forgets_every_key_down() {
+        let b = KeyEventBuilder::default();
+        feed(&b, &[(WM_KEYDOWN, VK_H, lp(0x23)), (WM_CHAR, H, lp(0x23)), (WM_KEYUP, VK_H, up(0x23))]);
+        assert_eq!(b.translated.lock().unwrap().len(), 1);
