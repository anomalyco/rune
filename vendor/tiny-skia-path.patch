+// The distance squared from `pt` to the segment from `line_start` along `tangent`.
+fn pt_to_tangent_line(pt: Point, line_start: Point, tangent: Point) -> f32 {
+    let ab0 = pt - line_start;
+    let numer = tangent.dot(ab0);
+    let denom = tangent.dot(tangent);
+    let t = numer / denom;
+    if t >= 0.0 && t <= 1.0 {
+        let hit = Point::from_xy(line_start.x + tangent.x * t, line_start.y + tangent.y * t);
+        hit.distance_to_sqd(pt)
+    } else {
+        pt.distance_to_sqd(line_start)
+    }
+}
