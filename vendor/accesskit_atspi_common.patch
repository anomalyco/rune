+#[cfg(test)]
+mod tests {
+    use super::*;
+    use accesskit::{Node, TreeInfo, TreeUpdate};
+
+    #[test]
+    fn item_size_of_set_overrides_container_without_leaking_onto_containers() {
+        let mut root = Node::new(Role::Window);
+        root.set_children(vec![NodeId(1), NodeId(6), NodeId(8), NodeId(10)]);
+
+        let mut tree = Node::new(Role::Tree);
+        tree.set_author_id("tree");
+        tree.set_size_of_set(2);
+        tree.set_children(vec![NodeId(2), NodeId(3)]);
+
+        let mut level1 = Node::new(Role::TreeItem);
+        level1.set_author_id("level1");
+        level1.set_level(0);
+        level1.set_position_in_set(0);
+        level1.set_size_of_set(2);
+
+        let mut level2 = Node::new(Role::TreeItem);
+        level2.set_author_id("level2");
+        level2.set_level(1);
+        level2.set_position_in_set(2);
+        level2.set_size_of_set(3);
+
+        let mut listbox = Node::new(Role::ListBox);
+        listbox.set_author_id("listbox");
+        listbox.set_size_of_set(4);
+        listbox.set_children(vec![NodeId(7)]);
+
+        let mut option = Node::new(Role::ListBoxOption);
+        option.set_author_id("option");
+        option.set_position_in_set(1);
+
+        let mut treegrid = Node::new(Role::TreeGrid);
+        treegrid.set_author_id("treegrid");
+        treegrid.set_size_of_set(2);
+        treegrid.set_children(vec![NodeId(9)]);
+
+        let mut row = Node::new(Role::Row);
+        row.set_author_id("row");
+        row.set_level(1);
+        row.set_position_in_set(0);
+        row.set_size_of_set(5);
+
+        let mut group = Node::new(Role::Group);
+        group.set_author_id("group");
+        group.set_size_of_set(3);
+
+        let update = TreeUpdate {
+            nodes: vec![
+                (NodeId(0), root),
+                (NodeId(1), tree),
+                (NodeId(2), level1),
+                (NodeId(3), level2),
+                (NodeId(6), listbox),
+                (NodeId(7), option),
+                (NodeId(8), treegrid),
+                (NodeId(9), row),
+                (NodeId(10), group),
+            ],
+            tree: Some(TreeInfo::new(NodeId(0))),
+            tree_id: TreeId::ROOT,
+            focus: NodeId(0),
+        };
+        let t = Tree::new(update, false);
+        fn find<'a>(node: NodeRef<'a>, key: &str) -> Option<NodeRef<'a>> {
+            if node.author_id() == Some(key) {
+                return Some(node);
+            }
+            node.children().find_map(|c| find(c, key))
+        }
+        let attrs = |key: &str| {
+            let node = find(t.state().root(), key).unwrap();
+            NodeWrapper(&node).attributes()
+        };
+
+        assert_eq!(attrs("tree").get("setsize"), None, "tree container must not report its own children count");
+        assert_eq!(attrs("level1").get("setsize").map(String::as_str), Some("2"), "level-1 treeitem reads its own size");
+        assert_eq!(attrs("level2").get("setsize").map(String::as_str), Some("3"), "level-2 treeitem overrides the tree container's size");
+        assert_eq!(attrs("level2").get("posinset").map(String::as_str), Some("3"));
+        assert_eq!(attrs("listbox").get("setsize"), None, "listbox container must not report its own children count");
+        assert_eq!(attrs("option").get("setsize").map(String::as_str), Some("4"), "unlevelled option falls back to container size");
+        assert_eq!(attrs("treegrid").get("setsize"), None, "treegrid container must not report its own children count");
+        assert_eq!(attrs("row").get("setsize").map(String::as_str), Some("5"), "levelled treegrid row reads its own size");
+        assert_eq!(attrs("group").get("setsize"), None, "group container must not report its own children count");
+    }
+
+    #[test]
+    fn aria_current_maps_to_atspi_current_attribute_and_omits_false() {
+        let cases = [
+            ("none", None, None),
+            ("false", Some(AriaCurrent::False), None),
+            ("page", Some(AriaCurrent::Page), Some("page")),
+            ("step", Some(AriaCurrent::Step), Some("step")),
+            ("location", Some(AriaCurrent::Location), Some("location")),
+            ("date", Some(AriaCurrent::Date), Some("date")),
+            ("time", Some(AriaCurrent::Time), Some("time")),
+            ("true", Some(AriaCurrent::True), Some("true")),
+        ];
+        let mut root = Node::new(Role::Window);
+        root.set_children((1..=cases.len()).map(|i| NodeId(i as u64)).collect::<Vec<_>>());
+        let mut nodes = vec![(NodeId(0), root)];
+        for (idx, (key, cur, _)) in cases.iter().enumerate() {
+            let mut n = Node::new(Role::Link);
+            n.set_author_id(*key);
+            if let Some(cur) = *cur {
+                n.set_aria_current(cur);
+            }
+            nodes.push((NodeId((idx + 1) as u64), n));
+        }
+        let update = TreeUpdate {
+            nodes,
+            tree: Some(TreeInfo::new(NodeId(0))),
+            tree_id: TreeId::ROOT,
+            focus: NodeId(0),
+        };
+        let t = Tree::new(update, false);
+        for (key, _, expected) in cases {
+            let node = t.state().root().children().find(|c| c.author_id() == Some(key)).unwrap();
+            let attrs = NodeWrapper(&node).attributes();
+            assert_eq!(attrs.get("current").map(String::as_str), expected, "current attribute mismatch for {key}");
+        }
+    }
+
+    #[test]
+    fn custom_actions_exposed_on_atspi_action_interface() {
+        let mut root = Node::new(Role::Window);
+        root.set_children(vec![NodeId(1), NodeId(2)]);
+
+        let mut row = Node::new(Role::Article);
+        row.set_author_id("row");
+        row.add_action(Action::CustomAction);
+        row.set_custom_actions(vec![
+            accesskit::CustomAction { id: 10, description: "Open".into() },
+            accesskit::CustomAction { id: 20, description: "More".into() },
+        ]);
+
+        let mut btn = Node::new(Role::Button);
+        btn.set_author_id("btn");
+        btn.add_action(Action::Click);
+        btn.add_action(Action::CustomAction);
+        btn.set_custom_actions(vec![
+            accesskit::CustomAction { id: 30, description: "Pin".into() },
+        ]);
+
+        let update = TreeUpdate {
+            nodes: vec![(NodeId(0), root), (NodeId(1), row), (NodeId(2), btn)],
+            tree: Some(TreeInfo::new(NodeId(0))),
+            tree_id: TreeId::ROOT,
+            focus: NodeId(0),
+        };
+        let t = Tree::new(update, false);
+        fn find<'a>(node: NodeRef<'a>, key: &str) -> Option<NodeRef<'a>> {
+            if node.author_id() == Some(key) {
+                return Some(node);
+            }
+            node.children().find_map(|c| find(c, key))
+        }
+        let row_node = find(t.state().root(), "row").unwrap();
+        let row_wrap = NodeWrapper(&row_node);
+        assert!(row_wrap.supports_action());
+        assert_eq!(row_wrap.n_actions(), 2);
+        assert_eq!(row_wrap.get_action_name(0), "Open");
+        assert_eq!(row_wrap.get_action_name(1), "More");
+        assert_eq!(row_wrap.get_action_name(2), "");
+
+        let btn_node = find(t.state().root(), "btn").unwrap();
+        let btn_wrap = NodeWrapper(&btn_node);
+        assert!(btn_wrap.supports_action());
+        assert_eq!(btn_wrap.n_actions(), 2);
+        assert_eq!(btn_wrap.get_action_name(0), "click");
+        assert_eq!(btn_wrap.get_action_name(1), "Pin");
+        assert_eq!(btn_wrap.get_action_name(-1), "");
+    }
+}
