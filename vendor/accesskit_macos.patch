+// Rune (vendor/accesskit_macos.patch): AppKit can call the accessibility methods below from a
+// background thread, while this process asks the system about itself (a hit test, or the focused
+// application), and the main thread may hold the adapter's `RefCell` borrow at that moment.
+// Borrowing off the main thread would race, or panic inside `extern "C"` and abort, so answer as
+// though the view had no adapter and let the superclass's own answer through.
+fn associated_object_on_main_thread(view: &NSView) -> Option<&AssociatedObject> {
+    MainThreadMarker::new()?;
+    associated_object(view)
+}
