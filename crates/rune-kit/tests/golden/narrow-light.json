[
{"path":"#0","role":"group","rect":[0.00,0.00,340.00,900.00],"fill":"#00000000"},
{"path":"#0/#0","role":"group","rect":[16.00,16.00,308.00,2398.98],"fill":"#00000000"},
{"path":"#0/#0/b0","role":"heading","rect":[16.00,16.00,308.00,24.00],"fill":"#00000000","key":"b0","text":"\u{2066}What's\u{2069} happening","color":"#161616ff"},
{"path":"#0/#0/b1","role":"text","rect":[16.00,50.00,308.00,179.20],"fill":"#00000000","key":"b1","text":"The server sends a heartbeat every 10 seconds, but \u{2066}\u{202f}\u{202f}\u{2066}stream.ts\u{2069}\u{202f}\u{202f}\u{2069} only reconnects on an \u{2066}\u{202f}\u{202f}\u{2066}error\u{2069}\u{202f}\u{202f}\u{2069} event. When the machine sleeps, the TCP connection goes \u{2066}half-open\u{2069}: the client never sees an error, so it waits forever. See the retry notes for the long version, which is deliberately wordy so that this paragraph has to wrap onto several lines at every width.","color":"#161616ff"},
{"path":"#0/#0/b2","role":"text","rect":[16.00,241.20,308.00,22.40],"fill":"#00000000","key":"b2","text":"Two smaller issues make it worse:","color":"#161616ff"},
{"path":"#0/#0/b3","role":"list","rect":[16.00,275.60,308.00,164.80],"fill":"#00000000","key":"b3"},
{"path":"#0/#0/b3/i0","role":"listitem","rect":[16.00,275.60,308.00,67.20],"fill":"#00000000","key":"i0"},
{"path":"#0/#0/b3/i0/#0","role":"text","rect":[16.00,275.60,32.00,67.20],"fill":"#00000000","text":"•","color":"#5c5c5cff"},
{"path":"#0/#0/b3/i0/#1","role":"group","rect":[48.00,275.60,276.00,67.20],"fill":"#00000000"},
{"path":"#0/#0/b3/i0/#1/b0","role":"text","rect":[48.00,275.60,276.00,67.20],"fill":"#00000000","key":"b0","text":"\u{2066}\u{202f}\u{202f}\u{2066}backoff.ts\u{2069}\u{202f}\u{202f}\u{2069} resets its delay on every message, so a flapping server is retried at full speed.","color":"#161616ff"},
{"path":"#0/#0/b3/i1","role":"listitem","rect":[16.00,346.80,308.00,93.60],"fill":"#00000000","key":"i1"},
{"path":"#0/#0/b3/i1/#0","role":"text","rect":[16.00,346.80,32.00,93.60],"fill":"#00000000","text":"•","color":"#5c5c5cff"},
{"path":"#0/#0/b3/i1/#1","role":"group","rect":[48.00,346.80,276.00,93.60],"fill":"#00000000"},
{"path":"#0/#0/b3/i1/#1/b0","role":"text","rect":[48.00,346.80,276.00,67.20],"fill":"#00000000","key":"b0","text":"The sidebar store ignores \u{2066}\u{202f}\u{202f}\u{2066}session.updated\u{2069}\u{202f}\u{202f}\u{2069} events that arrive before the first list fetch.","color":"#161616ff"},
{"path":"#0/#0/b3/i1/#1/b1","role":"list","rect":[48.00,418.01,276.00,22.40],"fill":"#00000000","key":"b1"},
{"path":"#0/#0/b3/i1/#1/b1/i0","role":"listitem","rect":[48.00,418.01,276.00,22.40],"fill":"#00000000","key":"i0"},
{"path":"#0/#0/b3/i1/#1/b1/i0/#0","role":"text","rect":[48.00,418.01,32.00,22.40],"fill":"#00000000","text":"•","color":"#5c5c5cff"},
{"path":"#0/#0/b3/i1/#1/b1/i0/#1","role":"group","rect":[80.00,418.01,244.00,22.40],"fill":"#00000000"},
{"path":"#0/#0/b3/i1/#1/b1/i0/#1/b0","role":"text","rect":[80.00,418.01,244.00,22.40],"fill":"#00000000","key":"b0","text":"A nested point with \u{2066}\u{202f}\u{202f}\u{2066}code\u{2069}\u{202f}\u{202f}\u{2069} in it.","color":"#161616ff"},
{"path":"#0/#0/b4","role":"heading","rect":[16.00,460.41,308.00,20.00],"fill":"#00000000","key":"b4","text":"The fix","color":"#161616ff"},
{"path":"#0/#0/b5","role":"text","rect":[16.00,488.41,308.00,67.20],"fill":"#00000000","key":"b5","text":"Treat silence as failure. If no event or heartbeat arrives for 25 seconds, close the stream and reconnect with backoff:","color":"#161616ff"},
{"path":"#0/#0/b6","role":"code","rect":[16.00,567.61,308.00,385.00],"fill":"#fafafaff","key":"b6"},
{"path":"#0/#0/b6/#0","role":"text","rect":[28.50,580.11,283.00,360.00],"fill":"#00000000","text":"const QUIET_MS = 25_000\n\nfunction watchdog(stream: EventStream, reconnect: () => void) {\n  let timer = setTimeout(fire, QUIET_MS) // restarted on every message\n  function fire() {\n    stream.close()\n    reconnect()\n  }\n  stream.on(\"message\", () => {\n    clearTimeout(timer)\n    timer = setTimeout(fire, QUIET_MS)\n  })\n}","color":"#161616ff"},
{"path":"#0/#0/b7","role":"code","rect":[16.00,976.61,308.00,65.00],"fill":"#fafafaff","key":"b7"},
{"path":"#0/#0/b7/#0","role":"text","rect":[28.50,989.11,283.00,40.00],"fill":"#00000000","text":"plain text fence, no language\n  keeps its   spacing","color":"#161616ff"},
{"path":"#0/#0/b8","role":"blockquote","rect":[16.00,1065.61,308.00,44.80],"fill":"#00000000","key":"b8"},
{"path":"#0/#0/b8/#0","role":"group","rect":[16.00,1065.61,2.00,44.80],"fill":"#eeeeeeff"},
{"path":"#0/#0/b8/#1","role":"group","rect":[18.00,1065.61,306.00,44.80],"fill":"#00000000"},
{"path":"#0/#0/b8/#1/b0","role":"text","rect":[30.00,1065.61,294.00,44.80],"fill":"#00000000","key":"b0","text":"Quoted advice: the reset must wait for a healthy minute. It spans two lines.","color":"#161616ff"},
{"path":"#0/#0/b9","role":"list","rect":[16.00,1126.41,308.00,142.39],"fill":"#00000000","key":"b9"},
{"path":"#0/#0/b9/i0","role":"listitem","rect":[16.00,1126.41,308.00,44.80],"fill":"#00000000","key":"i0"},
