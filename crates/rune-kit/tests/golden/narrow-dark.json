{"path":"#0/#0/b8/#1/b0","role":"text","rect":[30.00,1073.00,294.00,45.00],"fill":"#00000000","key":"b0","text":"Quoted advice: the reset must wait for a healthy minute. It spans two lines.","color":"#fafafaff"},
