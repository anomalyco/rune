[
{"path":"#0","role":"group","rect":[0.00,0.00,340.00,900.00],"fill":"#00000000"},
{"path":"#0/#0","role":"group","rect":[16.00,16.00,308.00,2407.00],"fill":"#00000000"},
{"path":"#0/#0/b0","role":"heading","rect":[16.00,16.00,308.00,24.00],"fill":"#00000000","key":"b0","text":"What's happening","color":"#fafafaff"},
{"path":"#0/#0/b1","role":"text","rect":[16.00,50.00,308.00,179.50],"fill":"#00000000","key":"b1","text":"The server sends a heartbeat every 10 seconds, but \u{202f}\u{202f}stream.ts\u{202f}\u{202f} only reconnects on an \u{202f}\u{202f}error\u{202f}\u{202f} event. When the machine sleeps, the TCP connection goes half-open: the client never sees an error, so it waits forever. See the retry notes for the long version, which is deliberately wordy so that this paragraph has to wrap onto several lines at every width.","color":"#fafafaff"},
{"path":"#0/#0/b2","role":"text","rect":[16.00,241.50,308.00,22.50],"fill":"#00000000","key":"b2","text":"Two smaller problems make it worse:","color":"#fafafaff"},
{"path":"#0/#0/b3","role":"group","rect":[16.00,276.00,308.00,173.50],"fill":"#00000000","key":"b3"},
{"path":"#0/#0/b3/i0","role":"group","rect":[16.00,276.00,308.00,67.50],"fill":"#00000000","key":"i0"},
{"path":"#0/#0/b3/i0/#0","role":"text","rect":[16.00,276.00,32.00,67.50],"fill":"#00000000","text":"•","color":"#aeaeaeff"},
{"path":"#0/#0/b3/i0/#1","role":"group","rect":[48.00,276.00,276.00,67.50],"fill":"#00000000"},
{"path":"#0/#0/b3/i0/#1/b0","role":"text","rect":[48.00,276.00,276.00,67.50],"fill":"#00000000","key":"b0","text":"\u{202f}\u{202f}backoff.ts\u{202f}\u{202f} resets its delay on every message, so a flapping server is retried at full speed.","color":"#fafafaff"},
{"path":"#0/#0/b3/i1","role":"group","rect":[16.00,347.50,308.00,102.00],"fill":"#00000000","key":"i1"},
{"path":"#0/#0/b3/i1/#0","role":"text","rect":[16.00,347.50,32.00,102.00],"fill":"#00000000","text":"•","color":"#aeaeaeff"},
{"path":"#0/#0/b3/i1/#1","role":"group","rect":[48.00,347.50,276.00,102.00],"fill":"#00000000"},
{"path":"#0/#0/b3/i1/#1/b0","role":"text","rect":[48.00,347.50,276.00,67.50],"fill":"#00000000","key":"b0","text":"The sidebar store ignores \u{202f}\u{202f}session.updated\u{202f}\u{202f} events that arrive before the first list fetch.","color":"#fafafaff"},
{"path":"#0/#0/b3/i1/#1/b1","role":"group","rect":[48.00,427.00,276.00,22.50],"fill":"#00000000","key":"b1"},
