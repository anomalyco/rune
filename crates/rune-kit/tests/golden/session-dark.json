[
{"path":"#0","role":"group","rect":[0.00,0.00,720.00,900.00],"fill":"#00000000"},
{"path":"#0/#0","role":"group","rect":[16.00,16.00,688.00,2004.77],"fill":"#00000000"},
{"path":"#0/#0/b0","role":"heading","rect":[16.00,16.00,688.00,24.00],"fill":"#00000000","key":"b0","text":"What's happening","color":"#fafafaff"},
{"path":"#0/#0/b1","role":"text","rect":[16.00,50.00,688.00,89.60],"fill":"#00000000","key":"b1","text":"The server sends a heartbeat every 10 seconds, but \u{202f}\u{202f}stream.ts\u{202f}\u{202f} only reconnects on an \u{202f}\u{202f}error\u{202f}\u{202f} event. When the machine sleeps, the TCP connection goes half-open: the client never sees an error, so it waits forever. See the retry notes for the long version, which is deliberately wordy so that this paragraph has to wrap onto several lines at every width.","color":"#fafafaff"},
{"path":"#0/#0/b2","role":"text","rect":[16.00,151.60,688.00,22.40],"fill":"#00000000","key":"b2","text":"Two smaller issues make it worse:","color":"#fafafaff"},
{"path":"#0/#0/b3","role":"list","rect":[16.00,186.00,688.00,75.20],"fill":"#00000000","key":"b3"},
{"path":"#0/#0/b3/i0","role":"listitem","rect":[16.00,186.00,688.00,22.40],"fill":"#00000000","key":"i0"},
{"path":"#0/#0/b3/i0/#0","role":"text","rect":[16.00,186.00,32.00,22.40],"fill":"#00000000","text":"•","color":"#aeaeaeff"},
{"path":"#0/#0/b3/i0/#1","role":"group","rect":[48.00,186.00,656.00,22.40],"fill":"#00000000"},
{"path":"#0/#0/b3/i0/#1/b0","role":"text","rect":[48.00,186.00,656.00,22.40],"fill":"#00000000","key":"b0","text":"\u{202f}\u{202f}backoff.ts\u{202f}\u{202f} resets its delay on every message, so a flapping server is retried at full speed.","color":"#fafafaff"},
{"path":"#0/#0/b3/i1","role":"listitem","rect":[16.00,212.40,688.00,48.80],"fill":"#00000000","key":"i1"},
{"path":"#0/#0/b3/i1/#0","role":"text","rect":[16.00,212.40,32.00,48.80],"fill":"#00000000","text":"•","color":"#aeaeaeff"},
{"path":"#0/#0/b3/i1/#1","role":"group","rect":[48.00,212.40,656.00,48.80],"fill":"#00000000"},
{"path":"#0/#0/b3/i1/#1/b0","role":"text","rect":[48.00,212.40,656.00,22.40],"fill":"#00000000","key":"b0","text":"The sidebar store ignores \u{202f}\u{202f}session.updated\u{202f}\u{202f} events that arrive before the first list fetch.","color":"#fafafaff"},
{"path":"#0/#0/b3/i1/#1/b1","role":"list","rect":[48.00,238.80,656.00,22.40],"fill":"#00000000","key":"b1"},
{"path":"#0/#0/b3/i1/#1/b1/i0","role":"listitem","rect":[48.00,238.80,656.00,22.40],"fill":"#00000000","key":"i0"},
{"path":"#0/#0/b3/i1/#1/b1/i0/#0","role":"text","rect":[48.00,238.80,32.00,22.40],"fill":"#00000000","text":"•","color":"#aeaeaeff"},
{"path":"#0/#0/b3/i1/#1/b1/i0/#1","role":"group","rect":[80.00,238.80,624.00,22.40],"fill":"#00000000"},
{"path":"#0/#0/b3/i1/#1/b1/i0/#1/b0","role":"text","rect":[80.00,238.80,624.00,22.40],"fill":"#00000000","key":"b0","text":"A nested point with \u{202f}\u{202f}code\u{202f}\u{202f} in it.","color":"#fafafaff"},
{"path":"#0/#0/b4","role":"heading","rect":[16.00,281.20,688.00,20.00],"fill":"#00000000","key":"b4","text":"The fix","color":"#fafafaff"},
{"path":"#0/#0/b5","role":"text","rect":[16.00,309.20,688.00,44.80],"fill":"#00000000","key":"b5","text":"Treat silence as failure. If no event or heartbeat arrives for 25 seconds, close the stream and reconnect with backoff:","color":"#fafafaff"},
{"path":"#0/#0/b6","role":"code","rect":[16.00,365.99,688.00,284.00],"fill":"#242424ff","key":"b6"},
{"path":"#0/#0/b6/#0","role":"text","rect":[28.00,377.99,664.00,260.00],"fill":"#00000000","text":"const QUIET_MS = 25_000\n\nfunction watchdog(stream: EventStream, reconnect: () => void) {\n  let timer = setTimeout(fire, QUIET_MS) // restarted on every message\n  function fire() {\n    stream.close()\n    reconnect()\n  }\n  stream.on(\"message\", () => {\n    clearTimeout(timer)\n    timer = setTimeout(fire, QUIET_MS)\n  })\n}","color":"#fafafaff"},
{"path":"#0/#0/b7","role":"code","rect":[16.00,673.99,688.00,64.00],"fill":"#242424ff","key":"b7"},
{"path":"#0/#0/b7/#0","role":"text","rect":[28.00,685.99,664.00,40.00],"fill":"#00000000","text":"plain text fence, no language\n  keeps its   spacing","color":"#fafafaff"},
{"path":"#0/#0/b8","role":"blockquote","rect":[16.00,761.99,688.00,22.40],"fill":"#00000000","key":"b8"},
{"path":"#0/#0/b8/#0","role":"group","rect":[16.00,761.99,2.00,22.40],"fill":"#3a3a3aff"},
{"path":"#0/#0/b8/#1","role":"group","rect":[18.00,761.99,686.00,22.40],"fill":"#00000000"},
{"path":"#0/#0/b8/#1/b0","role":"text","rect":[30.00,761.99,674.00,22.40],"fill":"#00000000","key":"b0","text":"Quoted advice: the reset must wait for a healthy minute. It spans two lines.","color":"#fafafaff"},
{"path":"#0/#0/b9","role":"list","rect":[16.00,800.39,688.00,75.20],"fill":"#00000000","key":"b9"},
{"path":"#0/#0/b9/i0","role":"listitem","rect":[16.00,800.39,688.00,22.40],"fill":"#00000000","key":"i0"},
