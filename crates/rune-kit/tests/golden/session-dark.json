{"path":"#0/#0/b9/i0/#1/b0","role":"text","rect":[48.00,801.50,656.00,22.50],"fill":"#00000000","key":"b0","text":"Watchdog: closes and reopens the stream after 25 s of silence.","color":"#fafafaff"},
