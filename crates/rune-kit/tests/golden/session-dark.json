{"path":"#0/#0/b9/i0/#1/b0","role":"text","rect":[48.00,800.39,656.00,22.40],"fill":"#00000000","key":"b0","text":"Watchdog: closes and reopens the stream after 25 s of silence.","color":"#fafafaff"},
{"path":"#0/#0/b9/i1","role":"listitem","rect":[16.00,826.79,688.00,22.40],"fill":"#00000000","key":"i1"},
{"path":"#0/#0/b9/i1/#0","role":"text","rect":[16.00,826.79,32.00,22.40],"fill":"#00000000","text":"2.","color":"#aeaeaeff"},
