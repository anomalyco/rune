{
  "name": "rune-www",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.ts",
    "preview": "vite preview --outDir .cloudflare/output/v0/workers/default/assets",
    "serve": "bun scripts/serve.ts",
    "check": "tsc --noEmit",
    "icons": "bun scripts/icons.ts",
    "images": "bun scripts/images.ts",
    "deploy:dev": "bun scripts/build.ts --mode dev && cf deploy --prebuilt --mode dev",
    "deploy:production": "bun scripts/build.ts --mode production && cf deploy --prebuilt --mode production"
  },
  "devDependencies": {
    "@cloudflare/build-output-utils": "0.8.5",
    "@cloudflare/vite-plugin": "2.0.0-beta.v.4",
    "@types/bun": "1.3.13",
    "@types/node": "25.5.0",
    "cf": "1.0.0-beta.12",
    "typescript": "6.0.2",
    "vite": "8.1.3"
  }
}
